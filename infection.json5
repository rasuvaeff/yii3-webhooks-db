{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "php://stderr",
        "summary": "build/infection-summary.log"
    },
    "testFramework": "testo",
    "minMsi": 100,
    "mutators": {
        "@default": true,
        // M260822120000AddDeliveryClaimColumns::down() drops the two claim
        // columns, and yiisoft/db-sqlite cannot drop a column at all — the very
        // first statement throws NotSupportedException. Every mutant of that
        // method therefore produces the identical exception, from the identical
        // line, whatever it changes; ClaimColumnsMigrationTest pins the
        // behaviour, but no assertion can tell the mutants apart. Exercising the
        // rollback for real needs a MySQL or PostgreSQL service container, which
        // this package's CI deliberately does not have.
        "global-ignore": [
            "Rasuvaeff\\Yii3WebhooksDb\\Migration\\M260822120000AddDeliveryClaimColumns::down"
        ]
    }
}
